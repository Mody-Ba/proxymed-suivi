# Modele du fichier local .env.properties (a creer a la racine du projet, a cote de pom.xml).
#   cp .env.properties.example .env.properties
# puis remplacer les valeurs ci-dessous. .env.properties est ignore par Git : il ne doit
# jamais etre commite. TOUTES les valeurs de ce modele sont fictives.

# Base PostgreSQL proxymed-suivi
PROXYMED_DB_USERNAME=utilisateur-de-la-base
PROXYMED_DB_PASSWORD=mot-de-passe-de-la-base

# Secret du badge (JWT) : exactement la meme valeur que PROXYMED_JWT_SECRET du service
# d'authentification (proxymed-auth), sinon tous les badges seront refuses (401).
PROXYMED_JWT_SECRET=remplacer-par-le-meme-secret-que-proxymed-auth-32-caracteres-min

# Origines du front autorisees a appeler ce service (CORS), separees par des virgules.
# Facultatif : http://localhost:4200 par defaut.
PROXYMED_CORS_ORIGINS=http://localhost:4200
